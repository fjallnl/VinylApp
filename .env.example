DATABASE_URL="postgresql://user:pass@localhost:5432/vinyldb"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-run-openssl-rand-base64-32"
APP_BASE_URL="http://localhost:3000"

# MinIO / S3-compatible storage
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="vinyl-covers"
S3_REGION="us-east-1"
# Optional override. Defaults to true for MinIO-compatible path-style URLs,
# and auto-switches to false for Cloudflare R2 endpoints.
S3_FORCE_PATH_STYLE="true"
NEXT_PUBLIC_S3_PUBLIC_URL="http://localhost:9000/vinyl-covers"

# SMTP2GO email delivery
SMTP2GO_HOST="mail.smtp2go.com"
SMTP2GO_PORT="587"
SMTP2GO_USER="your-smtp2go-username"
SMTP2GO_PASS="your-smtp2go-password"
SMTP_FROM="Vinyl Collection <no-reply@example.com>"

# Email verification
EMAIL_VERIFICATION_TTL_MINUTES="60"
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS="60"
EMAIL_VERIFICATION_RATE_LIMIT_DISABLED="false"
EMAIL_VERIFICATION_REGISTER_IP_LIMIT="10"
EMAIL_VERIFICATION_REGISTER_IP_WINDOW_SECONDS="3600"
EMAIL_VERIFICATION_REGISTER_EMAIL_LIMIT="3"
EMAIL_VERIFICATION_REGISTER_EMAIL_WINDOW_SECONDS="3600"
EMAIL_VERIFICATION_RESEND_IP_LIMIT="20"
EMAIL_VERIFICATION_RESEND_IP_WINDOW_SECONDS="3600"
EMAIL_VERIFICATION_RESEND_EMAIL_LIMIT="5"
EMAIL_VERIFICATION_RESEND_EMAIL_WINDOW_SECONDS="3600"
EMAIL_VERIFICATION_VERIFY_IP_LIMIT="30"
EMAIL_VERIFICATION_VERIFY_IP_WINDOW_SECONDS="3600"

# Discogs API (optional - increases rate limit)
DISCOGS_USER_AGENT="VinylApp/1.0"
DISCOGS_TOKEN=""
